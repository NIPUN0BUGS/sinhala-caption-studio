# Copy these to Vercel Environment Variables; never commit real secret values.
# Keep false until backend/services are configured. Set true only when ready to run sandbox tests.
# Keep PAYHERE_MODE=sandbox during tests; use live only after tests and merchant approval.
GURUPAPER_ENABLE_CHECKOUT=false
APP_URL=https://your-gurupaper-domain.vercel.app
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key
SUPABASE_STORAGE_BUCKET=guru-paper-uploads
PAYHERE_MODE=sandbox
PAYHERE_MERCHANT_ID=replace-with-sandbox-merchant-id
PAYHERE_MERCHANT_SECRET=replace-with-domain-specific-secret
OPENAI_API_KEY=replace-with-server-only-key
OPENAI_MODEL=gpt-4.1-mini
